# Скопируйте в .env и заполните значения:  cp .env.example .env

# --- Режим без ключей ---
# true — работаем на эвристиках и заглушках, в LLM/vision не ходим.
# Поставьте false и укажите ключ ниже, чтобы включить настоящую модель.
STUB_LLM=true
STUB_VISION=true

# --- LLM (любой OpenAI-совместимый провайдер) ---
# По умолчанию OpenAI. Для OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1  и ключ вида sk-or-...
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- Vision (анализ фото). Если пусто — берётся LLM_API_KEY. ---
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini

# --- Выбор реализации агента ---
# simple = RAG + каталог + композиция образа | stub = заглушка
AGENT_TYPE=simple

# --- База данных ---
# По умолчанию SQLite-файл backend/stylist.db — поднимать ничего не нужно.
# DATABASE_URL=sqlite+aiosqlite:///./stylist.db

# --- Подбор ---
RAG_TOP_K=3
DEFAULT_BUDGET_RUB=15000
