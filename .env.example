# Скопируйте в .env и заполните значения:  cp .env.example .env

# --- База данных ---
# По умолчанию SQLite-файл рядом с backend — ничего поднимать не нужно.
DATABASE_URL=sqlite+aiosqlite:///./stylist.db

# --- Выбор реализации агента ---
# simple = RAG + каталог + композиция образа | stub = заглушка
AGENT_TYPE=simple

# --- Режим без ключей ---
# true — работаем на эвристиках и заглушках, в LLM/vision не ходим.
# Поставьте false и укажите ключ ниже, чтобы включить настоящую модель.
STUB_LLM=true
STUB_VISION=true

# --- LLM через OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
VISION_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- База знаний по стилю ---
KNOWLEDGE_BASE_DIR=knowledge_base
RAG_TOP_K=3

# --- Каталог и подбор ---
CATALOG_SNAPSHOT=data/catalog.json
DEFAULT_BUDGET_RUB=15000
